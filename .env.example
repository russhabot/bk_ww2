# Token from @BotFather
BOT_TOKEN=123456789:ABCDefGhIJklMNopQRstUVwxyz

# Web App URL (HTTPS URL where this app is hosted, e.g. https://your-domain.com or ngrok URL)
WEBAPP_URL=https://your-domain.com

# Comma-separated Telegram User IDs for administrators
ADMINS=123456789,987654321

# Port for the web server
PORT=8080

# Announce channel for new country picks (optional, e.g. @your_channel or -100...)
ANNOUNCE_CHANNEL=

# Background ambient music URL (optional, defaults to Mars, the Bringer of War)
BACKGROUND_MUSIC_URL=https://upload.wikimedia.org/wikipedia/commons/4/4e/Holst_The_Planets_Mars_the_Bringer_of_War_USAF_Band.ogg
